# Local Docker Compose configuration
MYSQL_ROOT_PASSWORD=change-this-password
MYSQL_DATABASE=smartlearn
SMARTLEARN_ADMIN_EMAIL=admin@smartlearn.local
SMARTLEARN_ADMIN_PASSWORD=change-this-admin-password

# Pass these environment variables to the backend process (never to Angular).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_RATE_LIMIT_ENABLED=true
VIDEO_FFMPEG=
VIDEO_WORK_DIR=.local/video-work
SPEECH_PROVIDER=local
LOCAL_SPEECH_PYTHON=.local/voice-runtime/Scripts/python.exe
LOCAL_SPEECH_MODELS=.local/voices
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_SETTINGS_FILE=.local/azure-speech.json
AZURE_SPEECH_VOICE_FR=fr-FR-VivienneMultilingualNeural
AZURE_SPEECH_VOICE_EN=en-US-JennyNeural
AZURE_SPEECH_VOICE_AR=ar-SA-ZariyahNeural
